# Kuro v1.5.0 — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
# COPIAR a .env y reemplazar TODOS los valores:
#   cp .env.example .env
#
# WARNING: Never use these defaults in production. Generate secure secrets:
#   openssl rand -hex 32        # for passwords
#   openssl rand -base64 32     # for tokens/API keys
#
# WARNING: JWT_SECRET is the real security boundary.
# ═══════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# Use a strong generated password: openssl rand -hex 32
DB_PASSWORD=CHANGEME_GENERATE_WITH_openssl_rand_hex_32

# ── Application DB Role (v1.5.0) ───────────────────────────────────────────
# Non-superuser role created by migration 018. All services connect as this role.
# Password must match the one set in migration 018 or via:
#   ALTER ROLE kuro_app WITH LOGIN PASSWORD '<openssl rand -hex 32>';
DB_USER_APP=kuro_app
DB_PASSWORD_APP=CHANGEME_GENERATE_WITH_openssl_rand_hex_32

# ── API / JWT ───────────────────────────────────────────────────────────────
#   openssl rand -hex 32
#   If not set, an ephemeral secret is generated on startup (sessions lost on restart)
JWT_SECRET=CHANGEME_JWT_SECRET

# ── Rate Limiting (v1.0.0) ─────────────────────────────────────────────────
# Default: 2000 RPM, 500 burst. Admin: 5000 RPM, 1000 burst.
# /health endpoint is excluded from rate limiting.
RATE_LIMIT_RPM=2000
RATE_LIMIT_BURST=500
RATE_LIMIT_RPM_ADMIN=5000
RATE_LIMIT_BURST_ADMIN=1000

# ── OAuth2 GitHub (required for dashboard login) ──────────────────────────
# Create a GitHub OAuth App:
#   GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#   Homepage URL: http://localhost:3000
#   Authorization callback URL: http://localhost:8080/auth/callback
OAUTH_CLIENT_ID=your_github_oauth_app_client_id
OAUTH_CLIENT_SECRET=your_github_oauth_app_client_secret
OAUTH_REDIRECT_URL=https://localhost:8080/auth/callback

# ── Git Proxy ──────────────────────────────────────────────────────────────
# GitHub token with scope 'repo' for the Git Proxy to forward pushes
# after Kuro approves them.
# Create at: GitHub → Settings → Developer settings → Personal access tokens
#   - Classic token with scope: repo
#   - Fine-grained token with permissions: Contents: write, Metadata: read
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_USER=your_github_username

# ── Public URL ─────────────────────────────────────────────────────────────
# Used for links in commit status checks and notifications
API_PUBLIC_URL=http://your-server:8080

# ── Slack (optional) ──────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=CHANGEME_SLACK_URL

# ── Discord (optional) ─────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook

# ── Telegram (optional) ────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── Plane.so (optional) ───────────────────────────────────────────────────
PLANE_API_TOKEN=CHANGEME_PLANE_TOKEN
PLANE_WORKSPACE=CHANGEME_WORKSPACE
PLANE_PROJECT=CHANGEME_PROJECT_ID

# ── MinIO S3 (reemplazar ambos) ───────────────────────────────────────────
#   openssl rand -hex 32
S3_ACCESS_KEY=CHANGEME_MINIO_ACCESS_KEY
S3_SECRET_KEY=CHANGEME_MINIO_SECRET_KEY
S3_ENDPOINT=http://garage:9000
S3_BUCKET=scans-artifacts

# ── Docker Socket Access ───────────────────────────────────────────────────
# GID of the docker group on the host (required for worker to access Docker)
# Auto-detect on setup; override if getent fails
#DOCKER_GID=$(getent group docker | cut -d: -f3)

# ── Worker Scanner Limits (v1.0.0) ─────────────────────────────────────────
SCANNER_MEMORY_LIMIT=1g
SCANNER_CPU_LIMIT=1.0
SCANNER_TIMEOUT=300

# ── Proxy Scan (v1.0.0) ────────────────────────────────────────────────────
PROXY_FAIL_MODE=closed        # "closed" (block on failure, default) | "open" (pass-through)
PROXY_SCAN_TIMEOUT=30         # seconds, maximum scan wait time

# ── Clone URL Validation (v1.5.0) ──────────────────────────────────────────
# Comma-separated hostnames allowed for git clone + token injection.
# Tokens are ONLY injected for these hosts (prevents credential exfiltration).
KURO_ALLOWED_GIT_HOSTS=github.com,gitlab.com,bitbucket.org

# ── Scanner Suppression (v1.5.0, operator-only) ────────────────────────────
# Comma-separated scanner names to suppress. Default: none (fail-closed).
# .kuro.yml in scanned repos is NO LONGER honored.
KURO_DISABLED_SCANNERS=
KURO_IGNORED_PATHS=

# ── OpenTelemetry (optional) ──────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://signoz-otel-collector:4318

# ── Infisical (optional, deferred) ────────────────────────────────────────
INFISICAL_DB_URL=postgresql://kuro:${DB_PASSWORD}@127.0.0.1:5432/infisical

# ── TLS (optional, recommended in production) ──────────────────────────────
TLS_CERT_FILE=
TLS_KEY_FILE=
