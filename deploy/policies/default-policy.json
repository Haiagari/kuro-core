{
  "name": "kuro-default-policy",
  "version": "1.1.0",
  "rules": [
    {
      "scanner": "gitleaks",
      "action": "BLOCK",
      "reason": "Hardcoded credentials block the merge"
    },
    {
      "scanner": "trufflehog",
      "action": "BLOCK",
      "reason": "Detected secrets block, including unverified offline detections"
    },
    {
      "severity": "CRITICAL",
      "action": "BLOCK",
      "reason": "Critical vulnerabilities block immediately"
    },
    {
      "severity": "HIGH",
      "threshold": 1,
      "action": "MANUAL_REVIEW",
      "reason": "Any high severity finding requires review"
    },
    {
      "scanner": "checkov",
      "action": "BLOCK",
      "reason": "Any finding from this scanner blocks under the default policy"
    },
    {
      "scanner": "trivy",
      "action": "BLOCK",
      "reason": "Any finding from this scanner blocks under the default policy"
    }
  ]
}
